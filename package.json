        "vue-router": "^5.0.6",
        "vuex": "^4.1.0"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@babel/eslint-parser": "^7.28.6",
        "eslint": "^10.2.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-vue": "^10.9.0",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.3",
        "vite": "^8.0.14",
        "@vitejs/plugin-vue": "^6.0.7"
